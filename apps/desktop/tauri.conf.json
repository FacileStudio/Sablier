{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sablier",
  "mainBinaryName": "sablier-desktop",
  "version": "0.1.0",
  "identifier": "studio.facile.sablier",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Sablier",
        "url": "index.html",
        "width": 340,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Sablier time tracker in your menu bar",
    "publisher": "Facile",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
