{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sablier",
  "mainBinaryName": "sablier-desktop",
  "version": "0.2.2",
  "identifier": "studio.facile.sablier",
  "build": {
    "beforeDevCommand": {
      "script": "sh scripts/stage-ui.sh",
      "cwd": "."
    },
    "beforeBuildCommand": {
      "script": "sh scripts/stage-ui.sh",
      "cwd": "."
    },
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "popup",
        "title": "Sablier",
        "url": "popup.html",
        "width": 340,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data: https:; connect-src 'self' ipc: http://ipc.localhost https:",
      "dangerousDisableAssetCspModification": [
        "style-src"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "shortDescription": "Sablier time tracker in your menu bar",
    "publisher": "Facile",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERGRjRFRUNFRUE5RTNCMzYKUldRMk81N3F6dTcwMzYwekptdnBvU1ZEL0tPVmxSdWgwaVZlUjJYSGhjSzdyTGc0NDRvdGZTMDUK",
      "endpoints": [
        "https://github.com/FacileStudio/Sablier/releases/latest/download/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "studio.facile.sablier"
        ]
      }
    }
  }
}
