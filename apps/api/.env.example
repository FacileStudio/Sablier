# Local dev template — copy to apps/api/.env, it is loaded on startup.

# Required — the API refuses to start without it.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sablier?sslmode=disable

# Required in dev — the Vite client calls the API cross-origin.
# CORS_ALLOWED_ORIGINS is the canonical name; DOMAINS is still read as a fallback.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# The Vite dev proxy targets :4000; tronc's default is 8080, so pin it here.
PORT=4000

# Optional — defaults shown.
# APP_ENV=development
# LOG_LEVEL=info
# STORAGE_DIR=./data
# SSO_ONLY=false

# OIDC (optional — enable to use Authentik or any OpenID Connect provider)
# OIDC_ISSUER=https://authentik.yourdomain.com/application/o/sablier/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URL=http://localhost:4000/auth/oidc/callback
# OIDC_SUCCESS_URL=http://localhost:3000  # defaults to the first allowed origin

# Push notifications (VAPID) — optional; push stays off while unset.
# Generate with: go run ./cmd/gen-vapid-keys or npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=<base64url-encoded-public-key>
# VAPID_PRIVATE_KEY=<base64url-encoded-private-key>
# VAPID_SUBJECT=mailto:admin@example.com

# Journal log shipping (optional — both must be set or nothing ships).
# JOURNAL_URL=http://journal-api:4010
# JOURNAL_TOKEN=journal_sablier_...
