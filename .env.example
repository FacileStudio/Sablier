# Production template, consumed by docker-compose.

# Required — the API refuses to start without it.
DATABASE_URL=postgres://postgres:postgres@db:5432/sablier?sslmode=disable

# Required for production — your public frontend URL(s), comma-separated.
# CORS_ALLOWED_ORIGINS is the canonical name; DOMAINS is still read as a fallback.
CORS_ALLOWED_ORIGINS=https://app.yourdomain.com

# Optional — defaults shown.
# APP_ENV=production
# PORT=4000                 # tronc defaults to 8080; docker-compose pins 4000
# LOG_LEVEL=info
# STORAGE_DIR=/data
# SSO_ONLY=false

# OIDC (optional — enable to use Authentik or any OpenID Connect provider)
# OIDC_ISSUER=https://authentik.yourdomain.com/application/o/sablier/
# OIDC_CLIENT_ID=your-client-id
# OIDC_CLIENT_SECRET=your-client-secret
# OIDC_REDIRECT_URL=https://api.yourdomain.com/auth/oidc/callback
# OIDC_SUCCESS_URL=https://app.yourdomain.com  # defaults to the first allowed origin

# Push notifications (VAPID) — optional; push stays off while unset.
# Generate with: go run ./cmd/gen-vapid-keys or npx web-push generate-vapid-keys
# VAPID_PUBLIC_KEY=<base64url-encoded-public-key>
# VAPID_PRIVATE_KEY=<base64url-encoded-private-key>
# VAPID_SUBJECT=mailto:admin@example.com

# Journal log shipping (optional — both must be set or nothing ships; per-app key
# from Journal's Keys page; internal URL http://journal-api:4010 on la ruche)
# JOURNAL_URL=http://journal-api:4010
# JOURNAL_TOKEN=journal_sablier_...

# docker-compose only — not read by the API.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=sablier
